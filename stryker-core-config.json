{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "project": "EricksonLopez.RateLimiting.csproj",
    "test-projects": [
      "tests/EricksonLopez.RateLimiting.Tests/EricksonLopez.RateLimiting.Tests.csproj"
    ],
    "reporters": [
      "ClearText",
      "Html",
      "Json"
    ],
    "concurrency": 2,
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "mutate": [
      "src/EricksonLopez.RateLimiting/**/*.cs",
      "!src/EricksonLopez.RateLimiting/bin/**/*",
      "!src/EricksonLopez.RateLimiting/obj/**/*"
    ],
    "ignore-methods": [
      "*ConfigureAwait*",
      "*Record*",
      "*RecordRequest*",
      "*AcquireSucceeded*",
      "*AcquireRejected*",
      "*AcquireFailed*",
      "*Log*"
    ]
  }
}
