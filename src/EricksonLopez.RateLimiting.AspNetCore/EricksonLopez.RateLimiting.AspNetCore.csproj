<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.RateLimiting.AspNetCore</AssemblyName>
    <RootNamespace>EricksonLopez.RateLimiting.AspNetCore</RootNamespace>
    <PackageId>EricksonLopez.RateLimiting.AspNetCore</PackageId>
    <Description>ASP.NET Core middleware and endpoint integration for EricksonLopez.RateLimiting. Emits standard rate limit headers and enforces 429 Too Many Requests responses.</Description>
    <PackageTags>$(CommonPackageTags);aspnetcore;aspnet-core;middleware;http;webapi;minimal-apis;endpoint-routing;rate-limit-headers;problem-details;too-many-requests</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.RateLimiting\EricksonLopez.RateLimiting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.RateLimiting.AspNetCore.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
